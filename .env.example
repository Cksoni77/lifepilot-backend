DATABASE_URL=jdbc:postgresql://<NEON_HOST>/<DATABASE>?sslmode=require
DATABASE_USERNAME=<NEON_USERNAME>
DATABASE_PASSWORD=<NEON_PASSWORD>
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
PORT=8080
JWT_SECRET=<GENERATE_A_UNIQUE_SECRET>
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_RESPONSE_TIMEOUT_SECONDS=120
RECOMMENDATION_PRIORITY_WEIGHT=0.30
RECOMMENDATION_URGENCY_WEIGHT=0.30
RECOMMENDATION_DEADLINE_WEIGHT=0.20
RECOMMENDATION_GOAL_RELEVANCE_WEIGHT=0.20
